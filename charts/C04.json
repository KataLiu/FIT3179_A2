{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 570,
  "background": "#FFFEF8",
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27.5
    ],
    "scale": 860
  },
  "params": [
    {
      "name": "species_select",
      "value": "Australian Magpie",
      "bind": {
        "input": "select",
        "options": [
          "All three selected birds",
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Laughing Kookaburra"
        ],
        "name": "Species: "
      }
    },
    {
      "name": "source_select",
      "value": "Both sources",
      "bind": {
        "input": "select",
        "options": [
          "Both sources",
          "eBird Australia",
          "BirdLife Birdata"
        ],
        "name": "Source: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/Australia_States_ASGS2021_Simplified_Fixed.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F3EBCF",
        "stroke": "#819780",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C04_HeroSpeciesSampleLocations_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "month": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "species_select === 'All three selected birds' || datum.species === species_select"
        },
        {
          "filter": "source_select === 'Both sources' || datum.source === source_select"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 28,
        "opacity": 0.58,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.35,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Australian Magpie",
              "Rainbow Lorikeet",
              "Laughing Kookaburra"
            ],
            "range": [
              "#3978B8",
              "#E56B3F",
              "#E5A93D"
            ]
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "symbolType": "circle",
            "symbolSize": 80,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelExpr": "datum.label === 'Australian Magpie' ? 'Magpie' : datum.label === 'Rainbow Lorikeet' ? 'Lorikeet' : 'Kookaburra'",
            "labelLimit": 200,
            "columnPadding": 24,
            "values": {
              "expr": "species_select === 'All three selected birds' ? ['Australian Magpie', 'Rainbow Lorikeet', 'Laughing Kookaburra'] : [species_select]"
            }
          }
        },
        "tooltip": [
          {
            "field": "species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "scientific_name",
            "type": "nominal",
            "title": "Scientific name"
          },
          {
            "field": "source",
            "type": "nominal",
            "title": "Citizen-science source"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "[species_select === 'Laughing Kookaburra' ? 'No Laughing Kookaburra records come from the Northern Territory.' : species_select === 'Rainbow Lorikeet' ? 'Rainbow Lorikeets are rarely reported in the Northern Territory.' : species_select === 'Australian Magpie' ? 'Australian Magpies are reported in every state and territory.' : 'Magpies appear everywhere; Kookaburras are absent from the NT sample.', 'Each state contributes up to ' + (source_select === 'Both sources' ? '280' : '140') + ' points per species, so density shows sampling, not abundance.']",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#7A5A12",
        "align": "left",
        "baseline": "bottom",
        "lineHeight": 18
      },
      "encoding": {
        "x": {
          "value": 14
        },
        "y": {
          "value": 550
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "padding": 8,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
