{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 570,
  "background": "#FFFEF8",
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27.5
    ],
    "scale": 860
  },
  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "name": "Year: "
      }
    },
    {
      "name": "source_select",
      "value": "Combined",
      "bind": {
        "input": "select",
        "options": [
          "Combined",
          "eBird Australia",
          "BirdLife Birdata"
        ],
        "name": "Source: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/Australia_States_ASGS2021_Simplified_Fixed.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F3EBCF",
        "stroke": "#819780",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "ebird_records": "number",
            "birdata_records": "number",
            "total_records": "number",
            "birdata_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        },
        {
          "calculate": "source_select === 'eBird Australia' ? datum.ebird_records : source_select === 'BirdLife Birdata' ? datum.birdata_records : datum.total_records",
          "as": "selected_records"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#3E7856",
        "opacity": 0.78,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "selected_records",
          "type": "quantitative",
          "title": "Number of records",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [
              0,
              4200
            ]
          },
          "legend": {
            "orient": "right",
            "format": "~s",
            "titleFontWeight": "normal",
            "title": "Records",
            "titleLimit": 120,
            "labelLimit": 80,
            "values": {
              "expr": "source_select === 'BirdLife Birdata' ? [50000, 100000, 200000] : [500000, 1000000, 2500000]"
            }
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "selected_records",
            "type": "quantitative",
            "title": "Selected records",
            "format": ","
          },
          {
            "field": "ebird_records",
            "type": "quantitative",
            "title": "eBird records",
            "format": ","
          },
          {
            "field": "birdata_records",
            "type": "quantitative",
            "title": "Birdata records",
            "format": ","
          },
          {
            "field": "birdata_share",
            "type": "quantitative",
            "title": "Birdata share",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "ebird_records": "number",
            "birdata_records": "number",
            "total_records": "number",
            "birdata_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        },
        {
          "calculate": "source_select === 'eBird Australia' ? datum.ebird_records : source_select === 'BirdLife Birdata' ? datum.birdata_records : datum.total_records",
          "as": "selected_records"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "selected_records",
              "as": "max_records"
            }
          ]
        },
        {
          "calculate": "datum.selected_records / datum.max_records",
          "as": "relative_size"
        },
        {
          "filter": "datum.relative_size >= 0.3"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 0,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state_code",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "ebird_records": "number",
            "birdata_records": "number",
            "total_records": "number",
            "birdata_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        },
        {
          "calculate": "source_select === 'eBird Australia' ? datum.ebird_records : source_select === 'BirdLife Birdata' ? datum.birdata_records : datum.total_records",
          "as": "selected_records"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "selected_records",
              "as": "max_records"
            }
          ]
        },
        {
          "calculate": "datum.selected_records / datum.max_records",
          "as": "relative_size"
        },
        {
          "filter": "datum.relative_size < 0.3"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -24,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#34443A",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state_code",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "ebird_records": "number",
            "birdata_records": "number",
            "total_records": "number",
            "birdata_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        },
        {
          "calculate": "source_select === 'eBird Australia' ? datum.ebird_records : source_select === 'BirdLife Birdata' ? datum.birdata_records : datum.total_records",
          "as": "selected_records"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "selected_records",
              "as": "max_records"
            }
          ]
        },
        {
          "filter": "datum.selected_records === datum.max_records"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": null,
        "stroke": "#7A5A12",
        "strokeWidth": 2.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "selected_records",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "ebird_records": "number",
            "birdata_records": "number",
            "total_records": "number",
            "birdata_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        },
        {
          "calculate": "source_select === 'eBird Australia' ? datum.ebird_records : source_select === 'BirdLife Birdata' ? datum.birdata_records : datum.total_records",
          "as": "selected_records"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "selected_records",
              "as": "max_records"
            }
          ]
        },
        {
          "filter": "datum.selected_records === datum.max_records"
        },
        {
          "calculate": "'Most records in ' + datum.year + ': ' + datum.state + ' (' + (datum.selected_records >= 1000000 ? format(datum.selected_records / 1000000, '.2f') + 'M' : format(datum.selected_records / 1000, '.0f') + 'k') + ')'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#7A5A12",
        "align": "left"
      },
      "encoding": {
        "x": {
          "value": 14
        },
        "y": {
          "value": 548
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "symbolFillColor": "#3E7856",
      "padding": 10,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
