{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 484,
  "height": 370,
  "background": "#FFFEF8",
  "params": [
    {
      "name": "source_select",
      "value": "Combined",
      "bind": {
        "input": "select",
        "options": [
          "Combined",
          "eBird Australia",
          "BirdLife Birdata"
        ],
        "name": "Source: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C03_C08_MonthlyRecords_2018_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "month": "number",
        "exact_count": "number",
        "annual_total": "number",
        "share_of_source_year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "source_select === 'Combined' || datum.source === source_select"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "exact_count",
          "as": "records"
        }
      ],
      "groupby": [
        "year",
        "month",
        "month_name"
      ]
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#FFFEF8",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },
    "y": {
      "field": "month_name",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "axis": {
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },
    "color": {
      "field": "records",
      "type": "quantitative",
      "title": "Number of records",
      "scale": {
        "range": [
          "#F2F7EE",
          "#DCEBD5",
          "#B9D8AE",
          "#82B77D",
          "#4B8F5A",
          "#1F5D3B"
        ]
      },
      "legend": {
        "orient": "right",
        "format": "~s",
        "gradientLength": 260,
        "titleFontWeight": "normal",
        "title": "Records",
        "titleLimit": 120,
        "labelLimit": 80
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "month_name",
        "type": "ordinal",
        "title": "Month"
      },
      {
        "field": "records",
        "type": "quantitative",
        "title": "Records",
        "format": ","
      }
    ]
  },
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "grid": false,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "padding": 10,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
