{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Citizen-science bird records, 2018–2024",
    "subtitle": [
      "eBird records grew strongly, while Birdata remained around one million records per year.",
      "Record totals indicate reporting activity, not bird abundance."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#5F6B63",
    "offset": 15
  },
  "width": 700,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2/refs/heads/main/data/C02_AnnualRecords_2018_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "exact_count": "number",
        "records_millions": "number"
      }
    }
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 70
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },
    "y": {
      "field": "records_millions",
      "type": "quantitative",
      "title": "Records (millions)",
      "scale": {
        "domain": [0, 9]
      },
      "axis": {
        "gridColor": "#E3E8E2",
        "domain": false,
        "tickCount": 6,
        "labelExpr": "datum.value + 'M'"
      }
    },
    "color": {
      "field": "source",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "eBird Australia",
          "BirdLife Birdata"
        ],
        "range": [
          "#3E7856",
          "#E49A3A"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "symbolStrokeWidth": 4
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "source",
        "type": "nominal",
        "title": "Citizen-science source"
      },
      {
        "field": "exact_count",
        "type": "quantitative",
        "title": "Records",
        "format": ","
      }
    ]
  },
  "config": {
    "background": "#FFFEF8",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "titleFontWeight": "normal"
    }
  }
}