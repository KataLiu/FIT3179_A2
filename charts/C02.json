{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 550,
  "height": 360,
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C02_AnnualRecords_2018_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "exact_count": "number",
        "records_millions": "number"
      }
    }
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 70
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },
    "y": {
      "field": "records_millions",
      "type": "quantitative",
      "title": "Records (millions)",
      "scale": {
        "domain": [
          0,
          9
        ]
      },
      "axis": {
        "grid": true,
        "gridColor": "#DCE4DF",
        "gridOpacity": 1,
        "domain": false,
        "tickCount": 5,
        "labelExpr": "datum.value + 'M'"
      }
    },
    "color": {
      "field": "source",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "eBird Australia",
          "BirdLife Birdata"
        ],
        "range": [
          "#3E7856",
          "#E89A32"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "symbolType": "circle",
        "symbolSize": 160,
        "labelFontSize": 12,
        "offset": 8,
        "labelExpr": "datum.label === 'eBird Australia' ? 'eBird' : 'Birdata'",
        "labelLimit": 100
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "source",
        "type": "nominal",
        "title": "Citizen-science source"
      },
      {
        "field": "exact_count",
        "type": "quantitative",
        "title": "Records",
        "format": ","
      }
    ]
  },
  "config": {
    "background": "#FFFEF8",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
