{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 555,
  "height": 410,
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "abs_state_code": "number",
        "longitude": "number",
        "latitude": "number",
        "ebird_records": "number",
        "birdata_records": "number",
        "total_records": "number",
        "birdata_share": "number",
        "record_rank": "number"
      }
    }
  },
  "params": [
    {
      "name": "highlight_state",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Highlight state: ",
        "options": [
          "All",
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "NT",
          "ACT"
        ],
        "labels": [
          "All states and territories",
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          2018,
          2024.8
        ],
        "nice": false
      },
      "axis": {
        "values": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "format": "d",
        "labelAngle": 0,
        "labelPadding": 9,
        "tickSize": 0,
        "domain": false,
        "grid": false,
        "labelFlush": false
      }
    },
    "y": {
      "field": "record_rank",
      "type": "quantitative",
      "title": "Rank (1 = most records)",
      "scale": {
        "domain": [
          8.5,
          0.5
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "grid": true,
        "gridColor": "#DDE5DF",
        "gridWidth": 1,
        "tickSize": 0,
        "domain": false,
        "titlePadding": 14,
        "labels": false
      }
    },
    "color": {
      "field": "state_code",
      "type": "nominal",
      "title": "State or territory",
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "NT",
          "ACT"
        ],
        "range": [
          "#547FA3",
          "#3E7856",
          "#D7A438",
          "#8A6FA8",
          "#D97955",
          "#4F9A95",
          "#9A7051",
          "#7F8983"
        ]
      },
      "legend": null
    },
    "opacity": {
      "condition": {
        "test": "highlight_state === 'All' || datum.state_code === highlight_state",
        "value": 1
      },
      "value": 0.12
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "record_rank",
        "type": "quantitative",
        "title": "Record rank",
        "format": ".0f"
      },
      {
        "field": "total_records",
        "type": "quantitative",
        "title": "Combined records",
        "format": ","
      },
      {
        "field": "ebird_records",
        "type": "quantitative",
        "title": "eBird records",
        "format": ","
      },
      {
        "field": "birdata_records",
        "type": "quantitative",
        "title": "Birdata records",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "state_code",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 360,
        "stroke": "#FFFEF8",
        "strokeWidth": 1.5
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "record_rank",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#FFFFFF"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 13,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "state_code",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2020.9,
            "record_rank": 2.5,
            "label": "NSW held 3rd for six years, then rose to 2nd in 2024 \u2192"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#7A5A12",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "record_rank",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#7A5A12"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null
      }
    }
  ],
  "config": {
    "background": "#FFFEF8",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "titleFontWeight": "normal",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
