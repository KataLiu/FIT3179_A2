{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where do citizen scientists record birds?",
    "subtitle": [
      "Circle area represents the number of citizen-science records in each state or territory.",
      "Records indicate observation activity, not bird abundance."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#5F6B63",
    "offset": 16
  },
  "width": 760,
  "height": 450,
  "background": "#FFFEF8",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 620
  },
  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "name": "Year: "
      }
    },
    {
      "name": "source_select",
      "value": "Combined",
      "bind": {
        "input": "select",
        "options": [
          "Combined",
          "eBird Australia",
          "BirdLife Birdata"
        ],
        "name": "Source: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2/refs/heads/main/data/Australia_States_ASGS2021_Simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F3EBCF",
        "stroke": "#819780",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "ebird_records": "number",
            "birdata_records": "number",
            "total_records": "number",
            "birdata_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        },
        {
          "calculate": "source_select === 'eBird Australia' ? datum.ebird_records : source_select === 'BirdLife Birdata' ? datum.birdata_records : datum.total_records",
          "as": "selected_records"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#3E7856",
        "opacity": 0.78,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "selected_records",
          "type": "quantitative",
          "title": "Number of records",
          "scale": {
            "range": [
              100,
              4200
            ],
            "zero": true
          },
          "legend": {
            "orient": "right",
            "format": "~s",
            "titleFontWeight": "normal"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "selected_records",
            "type": "quantitative",
            "title": "Selected records",
            "format": ","
          },
          {
            "field": "ebird_records",
            "type": "quantitative",
            "title": "eBird records",
            "format": ","
          },
          {
            "field": "birdata_records",
            "type": "quantitative",
            "title": "Birdata records",
            "format": ","
          },
          {
            "field": "birdata_share",
            "type": "quantitative",
            "title": "Birdata share",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === year_select"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#34443A"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state_code",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "symbolFillColor": "#3E7856",
      "padding": 10
    }
  }
}