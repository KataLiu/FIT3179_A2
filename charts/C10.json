{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C10_C11_AussieBirdCount_Confirmed_2023_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "participants": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.year + ': ' + datum.participant_label + ' people'",
      "as": "year_label"
    },
    {
      "calculate": "sequence(1, 36)",
      "as": "unit_list"
    },
    {
      "flatten": [
        "unit_list"
      ],
      "as": [
        "unit"
      ]
    },
    {
      "calculate": "(datum.unit - 1) % 9",
      "as": "grid_column"
    },
    {
      "calculate": "floor((datum.unit - 1) / 9)",
      "as": "grid_row"
    },
    {
      "calculate": "round(datum.participants / 2000)",
      "as": "filled_units"
    },
    {
      "calculate": "datum.unit <= datum.filled_units ? 'Participants' : 'Scale remainder'",
      "as": "unit_status"
    }
  ],
  "facet": {
    "column": {
      "field": "year_label",
      "type": "nominal",
      "sort": [
        "2023: 60,598 people",
        "2024: 57,000+ people",
        "2025: 63,990 people"
      ],
      "header": {
        "title": null,
        "labelOrient": "bottom",
        "labelPadding": 10,
        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#34443A"
      }
    }
  },
  "spacing": 40,
  "spec": {
    "width": 300,
    "height": 165,
    "layer": [
      {
        "mark": {
          "type": "square",
          "size": 210,
          "cornerRadius": 2,
          "color": "#DDE7DC"
        },
        "encoding": {
          "x": {
            "field": "grid_column",
            "type": "ordinal",
            "axis": null
          },
          "y": {
            "field": "grid_row",
            "type": "ordinal",
            "sort": "descending",
            "axis": null
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.unit_status === 'Participants'"
          }
        ],
        "mark": {
          "type": "square",
          "size": 210,
          "cornerRadius": 2,
          "color": "#3E7856"
        },
        "encoding": {
          "x": {
            "field": "grid_column",
            "type": "ordinal",
            "axis": null
          },
          "y": {
            "field": "grid_row",
            "type": "ordinal",
            "sort": "descending",
            "axis": null
          },
          "tooltip": [
            {
              "field": "year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "participant_label",
              "type": "nominal",
              "title": "Reported participants"
            },
            {
              "value": "\u2248 2,000 participants",
              "title": "Each filled square"
            }
          ]
        }
      }
    ]
  },
  "config": {
    "background": "#FFFEF8",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleLimit": 180,
      "labelLimit": 150
    }
  }
}
