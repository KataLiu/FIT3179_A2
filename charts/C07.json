{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where does BirdLife Australia's Birdata contribute more records?",
    "subtitle": [
      "Birdata is BirdLife Australia's national platform for submitting bird observations.",
      "Colour shows Birdata's share of combined Birdata and eBird records in each state or territory.",
      "The percentage reflects reporting activity, not bird abundance."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitleColor": "#5F6B63",
    "offset": 17,
    "font": "Fraunces",
    "subtitleFont": "Source Sans 3",
    "subtitleLineHeight": 17
  },
  "width": 800,
  "height": 430,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 570
  },
  "params": [
    {
      "name": "selected_year",
      "value": 2024,
      "bind": {
        "input": "select",
        "name": "Year: ",
        "options": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "labels": [
          "2018",
          "2019",
          "2020",
          "2021",
          "2022",
          "2023",
          "2024"
        ]
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "abs_state_code": "number",
        "longitude": "number",
        "latitude": "number",
        "ebird_records": "number",
        "birdata_records": "number",
        "total_records": "number",
        "birdata_share": "number",
        "record_rank": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === selected_year"
    },
    {
      "lookup": "abs_state_code",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/Australia_States_ASGS2021_Simplified_Fixed.topojson",
          "format": {
            "type": "topojson",
            "feature": "australia_states"
          }
        },
        "key": "properties.abs_state_code"
      },
      "as": "state_geometry"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "shape": {
          "field": "state_geometry",
          "type": "geojson"
        },
        "color": {
          "field": "birdata_share",
          "type": "quantitative",
          "title": "Birdata share of records",
          "scale": {
            "domain": [
              0,
              0.42
            ],
            "range": [
              "#F2F0D8",
              "#C7DCB7",
              "#8EBB91",
              "#559178",
              "#245E55"
            ]
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "format": ".0%",
            "gradientLength": 230,
            "gradientThickness": 14,
            "titleFontSize": 12,
            "labelFontSize": 11,
            "offset": 12,
            "title": "Share",
            "titleLimit": 80,
            "labelLimit": 90
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "birdata_share",
            "type": "quantitative",
            "title": "Birdata share of combined records",
            "format": ".1%"
          },
          {
            "field": "birdata_records",
            "type": "quantitative",
            "title": "Birdata records",
            "format": ","
          },
          {
            "field": "ebird_records",
            "type": "quantitative",
            "title": "eBird records",
            "format": ","
          },
          {
            "field": "total_records",
            "type": "quantitative",
            "title": "Combined records",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#26372E"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state_code",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "birdata_share",
            "type": "quantitative",
            "title": "Birdata share of combined records",
            "format": ".1%"
          },
          {
            "field": "birdata_records",
            "type": "quantitative",
            "title": "Birdata records",
            "format": ","
          },
          {
            "field": "ebird_records",
            "type": "quantitative",
            "title": "eBird records",
            "format": ","
          },
          {
            "field": "total_records",
            "type": "quantitative",
            "title": "Combined records",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "background": "#FFFEF8",
    "font": "Source Sans 3",
    "view": {
      "stroke": null,
      "fill": "#FFFEF8"
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
