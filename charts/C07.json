{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 570,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": [
      0,
      -27.5
    ],
    "scale": 860
  },
  "params": [
    {
      "name": "selected_year",
      "value": 2024,
      "bind": {
        "input": "select",
        "name": "Year: ",
        "options": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "labels": [
          "2018",
          "2019",
          "2020",
          "2021",
          "2022",
          "2023",
          "2024"
        ]
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/C01_C07_C09_StateMetrics_2018_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "abs_state_code": "number",
        "longitude": "number",
        "latitude": "number",
        "ebird_records": "number",
        "birdata_records": "number",
        "total_records": "number",
        "birdata_share": "number",
        "record_rank": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === selected_year"
    },
    {
      "lookup": "abs_state_code",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/KataLiu/FIT3179_A2_BirdWatching/refs/heads/main/data/Australia_States_ASGS2021_Simplified_Fixed.topojson",
          "format": {
            "type": "topojson",
            "feature": "australia_states"
          }
        },
        "key": "properties.abs_state_code"
      },
      "as": "state_geometry"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "shape": {
          "field": "state_geometry",
          "type": "geojson"
        },
        "color": {
          "field": "birdata_share",
          "type": "quantitative",
          "title": "Birdata share of records",
          "scale": {
            "domain": [
              0,
              0.42
            ],
            "range": [
              "#F2F0D8",
              "#C7DCB7",
              "#8EBB91",
              "#559178",
              "#245E55"
            ]
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "format": ".0%",
            "gradientLength": 230,
            "gradientThickness": 14,
            "titleFontSize": 14,
            "labelFontSize": 13,
            "offset": 12,
            "title": "Share",
            "titleLimit": 80,
            "labelLimit": 90
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "birdata_share",
            "type": "quantitative",
            "title": "Birdata share of combined records",
            "format": ".1%"
          },
          {
            "field": "birdata_records",
            "type": "quantitative",
            "title": "Birdata records",
            "format": ","
          },
          {
            "field": "ebird_records",
            "type": "quantitative",
            "title": "eBird records",
            "format": ","
          },
          {
            "field": "total_records",
            "type": "quantitative",
            "title": "Combined records",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "birdata_share",
              "as": "max_share"
            }
          ]
        },
        {
          "filter": "datum.birdata_share === datum.max_share"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#7A5A12",
        "strokeWidth": 2,
        "strokeJoin": "round"
      },
      "encoding": {
        "shape": {
          "field": "state_geometry",
          "type": "geojson"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#26372E"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state_code",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "birdata_share",
            "type": "quantitative",
            "title": "Birdata share of combined records",
            "format": ".1%"
          },
          {
            "field": "birdata_records",
            "type": "quantitative",
            "title": "Birdata records",
            "format": ","
          },
          {
            "field": "ebird_records",
            "type": "quantitative",
            "title": "eBird records",
            "format": ","
          },
          {
            "field": "total_records",
            "type": "quantitative",
            "title": "Combined records",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "birdata_share",
              "as": "max_share"
            }
          ]
        },
        {
          "filter": "datum.birdata_share === datum.max_share"
        },
        {
          "calculate": "'Highest Birdata share in ' + datum.year + ': ' + datum.state + ' (' + format(datum.birdata_share, '.1%') + ')'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#7A5A12",
        "align": "left"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "value": 548
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "background": "#FFFEF8",
    "font": "Source Sans 3",
    "view": {
      "stroke": null,
      "fill": "#FFFEF8"
    },
    "legend": {
      "labelColor": "#34443A",
      "titleColor": "#34443A",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titleLimit": 180,
      "labelLimit": 150
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "header": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}
